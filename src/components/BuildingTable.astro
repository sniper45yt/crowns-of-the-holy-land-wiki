---
import data from '../data/buildings.json';

interface Props {
  type: string;
}

const { type } = Astro.props;
const building = data.buildings.find((b) => b.type === type);
if (!building) throw new Error(`Unknown building type: ${type}`);

const RESOURCES = [
  { key: 'gold', label: 'Gold' },
  { key: 'food', label: 'Food' },
  { key: 'stone', label: 'Stone' },
  { key: 'wood', label: 'Wood' },
] as const;

const fmt = (n: number) => n.toLocaleString('en-US');

function duration(totalSeconds: number): string {
  let s = Math.round(totalSeconds);
  const d = Math.floor(s / 86400); s -= d * 86400;
  const h = Math.floor(s / 3600); s -= h * 3600;
  const m = Math.floor(s / 60); s -= m * 60;
  const parts: string[] = [];
  if (d) parts.push(`${d}d`);
  if (h) parts.push(`${h}h`);
  if (m && !d) parts.push(`${m}m`);
  if (s && !d && !h) parts.push(`${s}s`);
  return parts.join(' ') || '0s';
}

// Only show resource columns this building actually costs.
const usedResources = RESOURCES.filter((r) => building.levels.some((l) => (l.cost as Record<string, number>)[r.key]));
const effectKeys = Object.keys(building.levels[0].effects);

const totals = building.levels.reduce(
  (acc, l) => {
    for (const r of RESOURCES) acc[r.key] += (l.cost as Record<string, number>)[r.key] ?? 0;
    acc.seconds += l.seconds;
    return acc;
  },
  { gold: 0, food: 0, stone: 0, wood: 0, seconds: 0 },
);

const nameOf = (t: string) => (data.names as Record<string, string>)[t] ?? t;

// What must already be built before upgrading to `level`, mirroring the game's own check:
// the Stronghold must be at least that level (except for the Stronghold itself), and every
// prerequisite that applies from `fromLevel` needs its building at a minimum level. A
// prerequisite with `trailBehind` needs the building at (target level - trailBehind).
function requiresFor(level: number): string {
  const needed = new Map<string, number>();
  const need = (t: string, lvl: number) => {
    if (lvl > 0 && lvl > (needed.get(t) ?? 0)) needed.set(t, lvl);
  };
  if (type !== 'stronghold') need('stronghold', level);
  for (const p of building!.prerequisites as any[]) {
    if ((p.fromLevel ?? 1) > level) continue;
    need(p.type, p.trailBehind != null ? level - p.trailBehind : p.minLevel ?? 0);
  }
  return [...needed.entries()].map(([t, lvl]) => `${nameOf(t)} ${lvl}`).join(', ') || '-';
}
---

<p>{building.description}</p>

<ul>
  <li><strong>Maximum level:</strong> {building.maxLevel}</li>
  <li><strong>How many you can build:</strong> {building.maxCount}</li>
</ul>

<h2 id="costs-by-level">Cost, requirements and build time by level</h2>
<p>
  The <strong>Requires</strong> column lists the buildings, and the level each must already have reached, before you can
  upgrade to that level.{type !== 'stronghold' && ' A building can never be upgraded past your Stronghold level.'}
</p>
<div class="building-table-wrap">
  <table>
    <thead>
      <tr>
        <th>Level</th>
        {usedResources.map((r) => <th>{r.label}</th>)}
        <th>Requires</th>
        <th>Build time</th>
        {effectKeys.map((k) => <th>{k}</th>)}
      </tr>
    </thead>
    <tbody>
      {building.levels.map((l) => (
        <tr>
          <td>{l.level}</td>
          {usedResources.map((r) => <td>{fmt((l.cost as Record<string, number>)[r.key] ?? 0)}</td>)}
          <td class="requires">{requiresFor(l.level)}</td>
          <td>{duration(l.seconds)}</td>
          {effectKeys.map((k) => {
            const v = (l.effects as Record<string, number | string>)[k];
            return <td>{typeof v === 'number' ? fmt(v) : v}</td>;
          })}
        </tr>
      ))}
    </tbody>
    <tfoot>
      <tr>
        <th>Total, 1 to {building.maxLevel}</th>
        {usedResources.map((r) => <th>{fmt(totals[r.key])}</th>)}
        <th></th>
        <th>{duration(totals.seconds)}</th>
        {effectKeys.map(() => <th></th>)}
      </tr>
    </tfoot>
  </table>
</div>

<p><small>Build times are before any speed-ups or research bonuses.</small></p>

<style>
  .building-table-wrap {
    overflow-x: auto;
  }
  table {
    font-variant-numeric: tabular-nums;
  }
  td,
  th {
    white-space: nowrap;
  }
  td.requires {
    white-space: normal;
    min-width: 12rem;
  }
  tfoot th {
    border-top: 2px solid var(--sl-color-gray-5);
  }
</style>
